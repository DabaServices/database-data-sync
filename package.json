{
  "name": "database-data-sync",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo",
    "check": "pnpm format:check && pnpm lint:check && pnpm typecheck",
    "test": "vitest run",
    "test:quiet": "vitest run --passWithNoTests --reporter=agent --silent=passed-only",
    "test:changed": "vitest run --changed --passWithNoTests --reporter=agent --silent=passed-only",
    "lint": "eslint",
    "lint:check": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write . && eslint --fix",
    "format:check": "prettier --check --log-level warn --cache .",
    "knowledge:validate": "node scripts/validate-knowledge.mjs",
    "knowledge:validate:run": "node scripts/validate-knowledge.mjs --quiet && prettier --check --log-level warn \"**/*.{yaml,yml}\"",
    "check:changed": "node scripts/check.mjs changed",
    "check:all": "node scripts/check.mjs all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "ajv": "^8.20.0",
    "eslint": "^10.4.1",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.1",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "zod": "^4.6.7"
  }
}
