{
  "name": "reshet-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "tsc -b && vite build",
    "deploy": "npx nwabap upload --conn_user $VITE_SAP_USERNAME --conn_password $VITE_SAP_PASSWORD",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo",
    "check": "pnpm format:check && pnpm lint:check && pnpm lint:css && pnpm typecheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:quiet": "vitest run --passWithNoTests --reporter=agent --silent=passed-only",
    "test:changed": "vitest run --changed --passWithNoTests --reporter=agent --silent=passed-only",
    "lint": "eslint",
    "lint:check": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "lint:css": "stylelint --cache --cache-strategy content --cache-location node_modules/.cache/stylelint/ \"src/**/*.{css,scss}\"",
    "format": "prettier --write . && eslint --fix",
    "format:check": "prettier --check --log-level warn --cache .",
    "knowledge:validate": "node scripts/validate-knowledge.mjs",
    "knowledge:validate:run": "node scripts/validate-knowledge.mjs --quiet && prettier --check --log-level warn \"**/*.{yaml,yml}\"",
    "check:changed": "node scripts/check.mjs changed",
    "check:all": "node scripts/check.mjs all"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/heebo": "^5.2.8",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "^1.168.19",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remeda": "^2.58.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/eslint-config": "latest",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/router-cli": "^1.167.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^29.1.1",
    "nwabap-ui5uploader": "^1.2.0",
    "prettier": "^3.9.4",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.100.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.8"
  }
}
